# Database Configuration
POSTGRES_URL=postgresql+psycopg://postgres:postgres123@localhost:5432/pshield
POSTGRES_DB=pshield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# OpenSearch Configuration
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200

# JWT Configuration
JWT_ISSUER=https://promptshield.local
JWT_AUDIENCE=checkred-ai-security
JWT_ALGORITHM=EdDSA

# These will use dev keys - replace with production keys in production
# JWT_PUBLIC_KEY=<your-jwt-public-key-base64>
# JWT_PRIVATE_KEY=<your-jwt-private-key-base64>

# Config Signing Keys - replace with production keys in production
# CONFIG_SIGN_PUBKEY=<your-config-public-key-base64>
# CONFIG_SIGN_PRIVKEY=<your-config-private-key-base64>

# Application Configuration
API_HOST=0.0.0.0
API_PORT=8081
DEBUG=true
ENVIRONMENT=development

# Frontend Configuration (for reference)
# VITE_API_URL=http://localhost:8081
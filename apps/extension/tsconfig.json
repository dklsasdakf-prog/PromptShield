{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["chrome"],
    "baseUrl": ".",
    "paths": {
      "@checkred-ai-security/shared": ["../../shared/ts/index.ts"],
      "@checkred-ai-security/shared/*": ["../../shared/ts/*"]
    }
  },
  "include": ["src/**/*"]
}
